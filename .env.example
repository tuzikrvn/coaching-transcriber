# Скопируй этот файл в .env и заполни значения

# Ключ AssemblyAI — получить на https://www.assemblyai.com/
ASSEMBLYAI_API_KEY=your_api_key_here

# Минимальная пауза для отображения в таблице (в секундах)
PAUSE_THRESHOLD_SEC=2.0

# Защита доступа (HTTP Basic Auth)
# Если APP_PASSWORD не задан — сервис открыт без пароля (удобно локально)
APP_USER=coach
APP_PASSWORD=your_password_here
